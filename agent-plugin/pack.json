{
  "name": "agent-plugin",
  "version": "0.1.0",
  "runtime": "agent-skills-v1",
  "phase": 2,
  "provider": "openrouter",
  "skills": [
    "generate-image",
    "generate-video",
    "read-image",
    "read-video",
    "read-audio",
    "generate-text",
    "generate-audio",
    "agent-memory"
  ],
  "entrypoints": {
    "openrouter": "scripts/openrouter.py",
    "doctor": "scripts/doctor.py"
  },
  "defaults": {
    "storageRoot": ".agents",
    "privacyMode": "local-first",
    "cloudApproval": "explicit",
    "apiKeyEnv": "OPENROUTER_API_KEY"
  }
}
